{
  "name": "accounting-saas",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:migrate:prod": "pnpm --filter api prisma:migrate:prod",
    "prisma:seed": "pnpm --filter api prisma:seed",
    "prisma:seed:nawc": "pnpm --filter api prisma:seed:nawc",
    "prisma:seed:nawc:payments": "pnpm --filter api prisma:seed:nawc:payments",
    "prisma:seed:hotnet": "pnpm --filter api prisma:seed:hotnet",
    "prisma:seed:hotnet:payments": "pnpm --filter api prisma:seed:hotnet:payments",
    "prisma:studio": "pnpm --filter api prisma:studio",
    "prisma:generate": "pnpm --filter api prisma:generate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
