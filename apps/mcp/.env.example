# ─────────────────────────────────────────────────────────────
# Atlas MCP connector (slug: accounting) — environment
# Copy to .env and fill in. NEVER commit .env. chmod 0600 in prod.
# ─────────────────────────────────────────────────────────────

# Identity of this connector
SYSTEM_SLUG="accounting"
SYSTEM_LABEL="Accounting"

# Shared secret proving the caller is the trusted Atlas agent.
# >= 32 random bytes. The server REFUSES TO START if this is unset/short.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ATLAS_MCP_SECRET=""
# During a rotation window, set the previous secret here so both are accepted.
ATLAS_MCP_SECRET_OLD=""

# Network — bind to the INTERNAL interface only; firewall the port to Atlas IPs.
MCP_HOST="127.0.0.1"
MCP_PORT="7801"

# READ-ONLY datasource (the atlas_mcp SELECT-only role — see scripts/db-hardening.sql)
MCP_DATABASE_URL="postgresql://atlas_mcp:REPLACE_ME@localhost:5432/accounting_dev?schema=public"

# Audit writer datasource (INSERT-only role — separate from the read-only account)
MCP_AUDIT_DATABASE_URL="postgresql://atlas_mcp_audit:REPLACE_ME@localhost:5432/accounting_dev?schema=public"

# Caps & limits
MCP_ROW_CAP="10000"
MCP_BYTE_CAP="1048576"          # ~1 MB serialized envelope
MCP_STATEMENT_TIMEOUT_MS="30000"
MCP_HTTP_BODY_LIMIT="65536"     # 64 KB request body
MCP_RATE_LIMIT_PER_MIN="30"     # per user
MCP_POOL_MAX="8"

# Role resolution cache
ROLE_CACHE_TTL_MS="60000"       # <= 60s per the guide
