# ─────────────────────────────────────────────────────────────
# Atlas MCP connector (slug: accounting) — environment
# Copy to .env and fill in. NEVER commit .env. chmod 0600 in prod.
# ─────────────────────────────────────────────────────────────

SYSTEM_SLUG="accounting"
SYSTEM_LABEL="Accounting"

# ── Atlas identity (JWT, Hayo MCP Integration Spec §3) ──
# Callers present an Atlas-signed JWT in `Authorization: Bearer`. We verify with
# Atlas's PUBLIC key. There is NO shared secret and NO identity header.
#
# Your MCP's unique audience id (per environment) — Atlas rejects tokens minted
# for another MCP. Atlas provides the real value (e.g. accounting-mcp-prod).
MCP_AUD="accounting-mcp-local"
# Exact issuer string to match (Atlas provides; will be URL-form, e.g. https://atlas.hayo.net).
ATLAS_ISS="atlas"
# PROD: Atlas's JWKS endpoint (public keys; rotation needs no redeploy on our side).
ATLAS_JWKS_URL=""
# DEV: local JWKS file from `pnpm --filter mcp gen:keys` (stands in for Atlas).
# Used only when ATLAS_JWKS_URL is blank.
ATLAS_JWT_PUBLIC_KEY_FILE="dev-keys/public.jwks.json"
ATLAS_TOKEN_LEEWAY_S="60"

# ── Network ──
# Bind to the INTERNAL interface only. TLS (HTTPS) is MANDATORY at the endpoint in
# staging/prod — terminate it at Nginx in front of this port.
MCP_HOST="127.0.0.1"
MCP_PORT="7801"

# ── Datasources ──
# READ-ONLY account (atlas_mcp — see scripts/db-hardening.sql)
MCP_DATABASE_URL="postgresql://atlas_mcp:REPLACE_ME@localhost:5432/accounting_dev?schema=public"
# Narrow identity writer (atlas_mcp_oid — UPDATE(oid) ON users ONLY). Blank = backfill disabled.
MCP_OID_WRITER_DATABASE_URL="postgresql://atlas_mcp_oid:REPLACE_ME@localhost:5432/accounting_dev?schema=public"
# Optional local audit copy (atlas_mcp_audit — INSERT-only). Atlas is the real logger; blank = off.
MCP_AUDIT_DATABASE_URL="postgresql://atlas_mcp_audit:REPLACE_ME@localhost:5432/accounting_dev?schema=public"

# ── Caps & limits ──
MCP_ROW_CAP="10000"
MCP_BYTE_CAP="1048576"          # ~1 MB serialized result
MCP_STATEMENT_TIMEOUT_MS="30000"
MCP_HTTP_BODY_LIMIT="65536"     # 64 KB request body
MCP_RATE_LIMIT_PER_MIN="30"     # per subject (oid)
MCP_POOL_MAX="8"
ROLE_CACHE_TTL_MS="60000"       # <= 60s per the spec
