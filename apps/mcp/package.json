{
  "name": "mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Atlas MCP read-only connector for the accounting SaaS (slug: accounting)",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/sqlGuard.test.ts test/auth.test.ts test/integration.test.ts",
    "test:unit": "tsx --test test/sqlGuard.test.ts test/auth.test.ts",
    "db:setup": "tsx scripts/setup-local-db.ts",
    "gen:keys": "tsx scripts/gen-dev-keys.ts",
    "kit": "tsx scripts/kit-conformance.ts",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "inspect": "mcp-inspector"
  },
  "dependencies": {
    "@accounting-saas/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "jose": "^6.1.0",
    "pg": "^8.22.0",
    "pgsql-ast-parser": "^12.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.16.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
