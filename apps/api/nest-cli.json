{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "webpackConfigPath": "webpack.config.js",
    "assets": [
      { "include": "modules/mail/templates/**/*.hbs", "outDir": "dist", "watchAssets": true }
    ],
    "watchAssets": true
  }
}
