# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accounting_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"


#CEO_EMAI
CEO_EMAIL="tahirasadaf330jb@gmail.com"
CEO_NAME="Sir Fraz"


# Microsoft Graph API (for sending real emails)
GRAPH_TENANT_ID="1df4ce7a-fa8a-42ff-9802-1f1be9c52d8d"
GRAPH_CLIENT_ID="59dccf54-1902-4d22-b4ac-4d8a45f906ac"
GRAPH_CLIENT_SECRET="HaB8Q~m1VKLijQHXMbwKLcTXfsghhyDeVmyiPb6o"
GRAPH_SENDER_EMAIL="noreply-internal@kingrevolution.com"

# JWT (app session issued after Microsoft SSO)
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-random-secret"
JWT_EXPIRATION="8h"
JWT_REFRESH_EXPIRATION="7d"

# Session/SSO cookie signing. Must be set and >= 16 chars or the API refuses to boot.
COOKIE_SECRET="generate-a-strong-random-32+char-secret"

# Login mode — one of:
#   "password" → email/password form only (SSO switched off)
#   "both"     → form + "Sign in with Microsoft" button (migration/verification period)
#   "sso"      → Microsoft only; password login disabled (final state)
# Rollout: password → both → sso. Keep NEXT_PUBLIC_AUTH_MODE in sync — it is baked
# into the Next.js build, so rebuild/restart the web app after changing it.
AUTH_MODE="password"
NEXT_PUBLIC_AUTH_MODE="password"

# Microsoft Entra SSO (OpenID Connect authorization-code + PKCE).
# Get these from IT (app registration). AAD_REDIRECT_URI must be registered EXACTLY.
AAD_TENANT_ID="1df4ce7a-fa8a-42ff-9802-1f1be9c52d8d"
AAD_CLIENT_ID="your-entra-app-client-id"
AAD_CLIENT_SECRET="your-entra-app-client-secret"
AAD_REDIRECT_URI="http://localhost:3001/api/v1/auth/microsoft/callback"

# App
API_PORT=3001
WEB_PORT=3000
NODE_ENV="development"

# MFA
MFA_APP_NAME="AccountingSaaS"

# API URL for frontend (baked into Next.js at build time)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# CORS - allow frontend origin on the API
WEB_URL="http://localhost:3000"

# Super Admin (seeded on first run)
SUPER_ADMIN_EMAIL="admin@accounting-saas.local"
SUPER_ADMIN_PASSWORD="ChangeMe123!"
